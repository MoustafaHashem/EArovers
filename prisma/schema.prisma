// Prisma Schema for جوالة هندسة عين شمس
// Database: Supabase (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums
// ============================================================
enum UserRole {
  scout
  admin
}

enum MemberStatus {
  active
  graduated
  inactive
}

enum ParticipantStatus {
  registered
  attended
  cancelled
}

// ============================================================
// Member Profiles (Unified)
// ============================================================
model Member {
  id                 String       @id @db.Uuid // Supabase auth.users.id OR gen_random_uuid() for historical
  hasAccount         Boolean      @default(false) @map("has_account")
  fullName           String       @map("full_name")
  phone              String?
  email              String?
  academicYear       String?      @map("academic_year")
  avatarUrl          String?      @map("avatar_url")
  role               UserRole     @default(scout)
  bio                String?
  dateOfBirth        DateTime?    @map("date_of_birth")
  joinYear           Int?         @map("join_year")
  graduationYear     Int?         @map("graduation_year")
  externalActivities String[]     @map("external_activities") // Array of strings
  status             MemberStatus @default(active)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  // Relations
  eventsCreated     Event[]            @relation("EventCreator")
  eventParticipants EventParticipant[]
  reviewedRequests  JoinRequest[]      @relation("RequestReviewer")
  uploadedMedia     Media[]
  userShields       UserShield[]
  awardedShields    UserShield[]       @relation("ShieldAwarder")
  roles             RoleHistory[]
  specialAwards     SpecialAward[]

  @@map("members")
}

// ============================================================
// Role History (Tracking a Member's roles across years)
// ============================================================
model RoleHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId    String   @map("member_id") @db.Uuid
  year        Int
  roleTitle   String   @map("role_title") // e.g., "قائد العشيرة", "قائد الميديا"
  isSecondary Boolean  @default(false) @map("is_secondary") // e.g., true for auxiliary roles
  createdAt   DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, year, roleTitle])
  @@map("role_history")
}

// ============================================================
// Events
// ============================================================
model Event {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  description     String?
  eventType       String    @map("event_type") // "معسكر", "مسابقة", "درع", "ندوة"
  location        String?
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  maxParticipants Int?      @map("max_participants")
  coverImage      String?   @map("cover_image") // Cloudinary URL
  isPublic        Boolean   @default(false) @map("is_public")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  creator       Member?            @relation("EventCreator", fields: [createdBy], references: [id])
  participants  EventParticipant[]
  sessions      Session[]
  media         Media[]
  achievements  Achievement[]
  specialAwards SpecialAward[]

  @@map("events")
}

// ============================================================
// Event Participation
// ============================================================
model EventParticipant {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId  String            @map("event_id") @db.Uuid
  memberId String            @map("member_id") @db.Uuid
  status   ParticipantStatus @default(registered)
  joinedAt DateTime          @default(now()) @map("joined_at")

  // Relations
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@map("event_participants")
}

// ============================================================
// Achievements / Hall of Fame
// ============================================================
model Achievement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String?
  placement String // e.g., "المركز الأول"
  eventId   String   @map("event_id") @db.Uuid
  shieldId  String?  @map("shield_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shield Shield? @relation(fields: [shieldId], references: [id], onDelete: SetNull)

  @@map("achievements")
}

// ============================================================
// Special Awards
// ============================================================
model SpecialAward {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  awardedAt DateTime @default(now()) @map("awarded_at")
  memberId  String   @map("member_id") @db.Uuid
  eventId   String?  @map("event_id") @db.Uuid

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@map("special_awards")
}

// ============================================================
// Scout Shields (Activity Categories)
// ============================================================
model Shield {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  image       String? // Cloudinary URL
  sortOrder   Int     @default(0) @map("sort_order")

  fields       Field[]
  userShields  UserShield[]
  achievements Achievement[]

  @@map("shields")
}

// ============================================================
// Fields (previously ShieldActivity)
// ============================================================
model Field {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shieldId    String  @map("shield_id") @db.Uuid
  name        String
  description String?
  image       String? // Cloudinary URL
  order       Int     @default(0)

  shield Shield @relation(fields: [shieldId], references: [id], onDelete: Cascade)

  @@map("fields")
}

// ============================================================
// User Shields (Awarded to members)
// ============================================================
model UserShield {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  shieldId  String   @map("shield_id") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at")
  awardedBy String?  @map("awarded_by") @db.Uuid

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shield  Shield  @relation(fields: [shieldId], references: [id], onDelete: Cascade)
  awarder Member? @relation("ShieldAwarder", fields: [awardedBy], references: [id])

  @@unique([memberId, shieldId])
  @@map("user_shields")
}

// ============================================================
// Training Sessions
// ============================================================
model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  instructor  String?
  sessionDate DateTime? @map("session_date")
  eventId     String?   @map("event_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id])

  @@map("sessions")
}

// ============================================================
// Media Gallery
// ============================================================
model Media {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String?
  url          String // Cloudinary URL
  thumbnailUrl String?  @map("thumbnail_url")
  category     String? // "مسابقات", "معسكرات", "دروع", "كواليس"
  eventId      String?  @map("event_id") @db.Uuid
  uploadedBy   String?  @map("uploaded_by") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  isFeatured   Boolean  @default(false) @map("is_featured")
  createdAt    DateTime @default(now()) @map("created_at")

  event    Event?  @relation(fields: [eventId], references: [id])
  uploader Member? @relation(fields: [uploadedBy], references: [id])

  @@map("media")
}

// ============================================================
// Join Requests (Public Form Submissions)
// ============================================================
model JoinRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String    @map("full_name")
  phone        String
  email        String?
  academicYear String    @map("academic_year")
  interests    String?
  status       String    @default("pending") // "pending", "approved", "rejected"
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  reviewedAt   DateTime? @map("reviewed_at")

  reviewer Member? @relation("RequestReviewer", fields: [reviewedBy], references: [id])

  @@map("join_requests")
}

// ============================================================
// Website Traffic Tracking
// ============================================================
model PageVisit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  path      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("page_visits")
}
